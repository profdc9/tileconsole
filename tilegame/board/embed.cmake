# Writes a C file holding the given files: embed_files(<out.c> <symbol> <dir> name...). Run at configure time.
function(embed_files out symbol dir)
    set(text "/* generated by embed.cmake: do not edit */\n#include <stddef.h>\n#include \"embedded.h\"\n\n")
    set(table "")
    set(i 0)
    foreach(name ${ARGN})
        file(READ ${dir}/${name} hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(LENGTH "${hex}" hexlen)
        math(EXPR size "${hexlen} / 2")
        string(APPEND text "static const unsigned char data_${i}[] = {${bytes}0};\n")
        string(APPEND table "    {\"${name}\", data_${i}, ${size}},\n")
        math(EXPR i "${i} + 1")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${dir}/${name})
    endforeach()
    string(APPEND text "\nconst embedded_file_t ${symbol}[] = {\n${table}    {NULL, NULL, 0},\n};\n")
    file(WRITE ${out}.tmp "${text}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${out}.tmp ${out})
endfunction()
